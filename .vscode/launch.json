{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "4Directions Farm (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-renderer",
        "canvaskit",
        "--web-port",
        "8080"
      ],
      "flutterMode": "debug"
    },
    {
      "name": "4Directions Farm (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define", "API_BASE_URL=http://10.0.2.2:3001/api/v1"],
      "flutterMode": "debug"
    },
    {
      "name": "4Directions Farm (iOS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define", "API_BASE_URL=http://127.0.0.1:3001/api/v1"],
      "flutterMode": "debug",
      "deviceId": "iPhone"
    },
    {
      "name": "4Directions Farm — Profile (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--web-port", "8080"],
      "flutterMode": "profile"
    },
    {
      "name": "4Directions Farm — Release (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--web-port", "8080"],
      "flutterMode": "release"
    }
  ],
  "compounds": [
    {
      "name": "All Devices",
      "configurations": [
        "4Directions Farm (Chrome)",
        "4Directions Farm (Android)"
      ]
    }
  ]
}
